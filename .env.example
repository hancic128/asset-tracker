# asset-tracker 环境变量参考
# 复制为 .env，按需修改

# 监听地址（默认 0.0.0.0，Docker 部署不要改成 127.0.0.1）
ASSET_HOST=0.0.0.0

# 监听端口
ASSET_PORT=8085

# 数据库路径（compose 部署时用卷挂载）
ASSET_DB=/opt/asset-tracker/asset-tracker.db

# 前端产物目录（不要改）
ASSET_STATIC=/app/static

# 部署版本标识，显示在 /health 和顶栏
ASSET_VERSION=latest

# 首次部署时设置管理员口令（已设过则忽略）
ASSET_INITIAL_PASSWORD=

# 每日 webhook 推送时刻（0-23，Asia/Shanghai）
ASSET_DIGEST_HOUR=9
